# Mobileum Renewals Intelligence — Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# Never commit .env with real secrets.

# --- Database ---
# Examples:
# SQLite (default for local development):
DATABASE_URL=sqlite:///./renewals.db
# PostgreSQL (production host / container / VM):
# DATABASE_URL=postgresql+psycopg2://renewals_user:PASSWORD@localhost:5432/renewals
# NOTE: Special characters in the database password MUST be URL-encoded (e.g. @ becomes %40, # becomes %23, / becomes %2F).

# Optional PostgreSQL container settings (used if running docker-compose):
POSTGRES_DB=renewals
POSTGRES_USER=renewals_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# --- Application Secrets ---
SECRET_KEY=change_this_to_a_long_random_secret_in_production

# --- Admin Authentication & Write Route Security (Addendum D) ---
# Mandatory in production. Snapshot uploads, deletes, and writes require admin sign-in.
ADMIN_PASSWORD=change_me_to_a_secure_admin_password
# Generate a 64-char hex key with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=change_this_to_a_random_64_character_hex_secret_key_in_production
# Set to "production" in production environments (enforces secure cookies by default)
ENVIRONMENT=development
# Set to true when serving over HTTPS; false for local HTTP dev
COOKIE_SECURE=false

# --- CORS Origins ---
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:5173","http://localhost:3000"]

# --- AI Provider ---
# Set AI_PROVIDER to one of: demo | gemini | openai | custom
# "demo" requires no API key and answers from local analytics data.
AI_PROVIDER=demo
AI_BASE_URL=
AI_MODEL_NAME=
AI_API_KEY=

# --- Uploads & Storage ---
UPLOAD_DIR=/app/uploads
